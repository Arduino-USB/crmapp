package com.crm;

import com.crm.embeds.*;
import com.crm.entites.Appointment;
import com.crm.entites.Message;
import com.crm.entites.Response;
import com.crm.entites.User;
import com.crm.enums.ResponseAction;
import com.crm.repos.AppointmentRepo;
import com.crm.repos.MessageRepo;
import com.crm.repos.ResponseRepo;
import com.crm.repos.UserRepo;
import org.springframework.stereotype.Component;

import java.time.Duration;
import java.time.Instant;
import java.util.HashMap;
import java.util.List;
import java.util.ArrayList;
import java.util.Map;
import java.util.Optional;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;

@Component
public class AppointmentReminderBot {

    private final UserRepo userRepo;
    private final AppointmentRepo appointmentRepo;
    private final MessageRepo messageRepo;
    private final ResponseRepo responseRepo;
    private final TextMgr textMgr;
    private final ActionMgr actionMgr;

    private final Map<Long, ResponseAction> lastExecutedActions = new HashMap<>();
    private final ExecutorService executorService = Executors.newFixedThreadPool(Runtime.getRuntime().availableProcessors());
    private static final String TAG = "Appointment Reminder Bot";

    public AppointmentReminderBot(
            UserRepo userRepo,
            AppointmentRepo appointmentRepo,
            MessageRepo messageRepo,
            ResponseRepo responseRepo,
            TextMgr textMgr,
            ActionMgr actionMgr
    ) {
        this.userRepo = userRepo;
        this.appointmentRepo = appointmentRepo;
        this.messageRepo = messageRepo;
        this.responseRepo = responseRepo;
        this.textMgr = textMgr;
        this.actionMgr = actionMgr;

        System.out.println("[AppointmentReminderBot] Initializing bean constructor...");
        System.out.println("[AppointmentReminderBot] Starting automated text sending thread pool with tag: " + TAG);

        new Thread(() -> {
            System.out.println("[AppointmentReminderBot] Worker loop daemon thread successfully spawned.");
            while (true) {
                try {
                    Thread.sleep(5000);
                    runWorkerLoop();
                } catch (InterruptedException ie) {
                    System.out.println("[AppointmentReminderBot] Worker thread interrupted: " + ie.getMessage());
                    Thread.currentThread().interrupt();
                    break;
                } catch (Exception e) {
                    System.out.println("[AppointmentReminderBot] CRITICAL WORKER EXCEPTION: " + e.getMessage());
                    e.printStackTrace();
                }
            }
        }).start();
    }

    private String parseText(User user, Appointment appointment, List<TextBlock> textObjs) {
        System.out.println("[AppointmentReminderBot].Parser Starting text parsing for User ID: " + (user != null ? user.getId() : "null") + ", Appointment ID: " + (appointment != null ? appointment.getId() : "null"));
        String finalText = "";
        
        if (textObjs == null || textObjs.isEmpty()) {
            System.out.println("[AppointmentReminderBot].Parser Warning: textObjs list is null or empty.");
            return finalText;
        }

        for (int i = 0; i < textObjs.size(); i++) {
            TextBlock textBlock = textObjs.get(i);
            System.out.println("[AppointmentReminderBot].Parser Processing TextBlock index " + i + " with mode: " + (textBlock != null ? textBlock.mode : "null"));
            
            if (textBlock == null) {
                continue;
            }
            
            if (textBlock.mode == TextBlock.Mode.TEXT) {
                System.out.println("[AppointmentReminderBot].Parser Appending plainText: " + textBlock.plainText);
                if (textBlock.plainText != null) {
                    finalText += textBlock.plainText;
                }
            } else if (textBlock.mode == TextBlock.Mode.IFELSE) {
                String varContents = null;
                
                if (textBlock.varType == TextBlock.VarType.USER_VAR) {
                    varContents = user != null ? user.getVar(textBlock.varName) : null;
                    System.out.println("[AppointmentReminderBot].Parser Evaluated USER_VAR '" + textBlock.varName + "' -> value: '" + varContents + "'");
                } else if (textBlock.varType == TextBlock.VarType.APPOINTMENT_VAR) {
                    varContents = appointment != null ? appointment.getVar(textBlock.varName) : null;  
                    System.out.println("[AppointmentReminderBot].Parser Evaluated APPOINTMENT_VAR '" + textBlock.varName + "' -> value: '" + varContents + "'");
                }
                
                if (varContents != null && !varContents.isEmpty()) {
                    System.out.println("[AppointmentReminderBot].Parser Variable '" + textBlock.varName + "' found and not empty. Appending ifText block size: " + (textBlock.ifText != null ? textBlock.ifText.size() : 0));
                    List<Integer> insertedIndexes = new ArrayList<>();        
                
                    if (textBlock.ifText != null) {
                        for (int j = 0; j < textBlock.ifText.size(); j++) {
                            boolean insertVar = false;
                            if (textBlock.insertIndexes != null) {
                                for (int k = 0; k < textBlock.insertIndexes.length; k++) {
                                    if (j == textBlock.insertIndexes[k] && !insertedIndexes.contains(j)) {
                                        insertVar = true;
                                    }
                                }
                            }
                        
                            if (insertVar) {
                                System.out.println("[AppointmentReminderBot].Parser Injecting varContents into finalText at index j=" + j);    
                                finalText += varContents;
                                insertedIndexes.add(j);
                                j--;
                            } else {
                                finalText += textBlock.ifText.get(j);
                            }        
                        }
                    }
                } else {
                    System.out.println("[AppointmentReminderBot].Parser Variable '" + textBlock.varName + "' was null/empty. Appending elseText.");
                    if (textBlock.elseText != null) {
                        finalText += textBlock.elseText;
                        System.out.println("[AppointmentReminderBot].Parser Appended elseText: " + textBlock.elseText);
                    } else {
                        System.out.println("[AppointmentReminderBot].Parser elseText was null, nothing appended for this IFELSE block.");
                    }
                }
            }
        }
        
        System.out.println("[AppointmentReminderBot].Parser Final parsed text message result: " + finalText);
        return finalText;
    }

    private void runWorkerLoop() {
        System.out.println("[AppointmentReminderBot] --- TICK START --- Fetching data from repositories...");
        List<Appointment> appointments = appointmentRepo.findAppointmentPhoneNotBlank();
        List<Message> messages = messageRepo.findAll();
        Instant currentTime = Instant.now();

        System.out.println("[AppointmentReminderBot] Found " + appointments.size() 
                + " appointment(s) and " + messages.size() + " message rule(s). Current Instant: " + currentTime + ". Processing concurrently via thread pool.");

        if (appointments.isEmpty()) {
            System.out.println("[AppointmentReminderBot] No appointments with valid phone numbers found for this tick.");
        }

        // === Process appointments concurrently using ExecutorService pool ===
        for (Appointment appointment : appointments) {
            executorService.submit(() -> {
                System.out.println("[AppointmentReminderBot] [THREAD POOL] Starting execution task for Appointment ID: " + appointment.getId());
                try {
                    // === 1. Handle customer replies ===
                    System.out.println("[AppointmentReminderBot] [REPLY CHECK] Checking customer replies for Appt ID " + appointment.getId());
                    Optional<User> userOpt = userRepo.findById(appointment.getUserId());
                    if (userOpt.isPresent()) {
                        System.out.println("[AppointmentReminderBot] [REPLY CHECK] User found for Appt ID " + appointment.getId() + " (User ID: " + userOpt.get().getId() + "). Delegating to handleCustomerReply.");
                        handleCustomerReply(appointment, userOpt.get());
                    } else {
                        System.out.println("[AppointmentReminderBot] [REPLY CHECK] No user found for Appt ID " + appointment.getId() + " with User ID: " + appointment.getUserId());
                    }

                    // === 2. Send automated messages ===
                    if (appointment.isStopTexting()) {
                        System.out.println("[AppointmentReminderBot] [OUTBOUND SKIPPED] Appt ID " + appointment.getId() + " has stopTexting=true. Bypassing outbound message rules.");
                        return;
                    }

                    Instant apptTime = appointment.getTime();
                    if (apptTime == null) {
                        System.out.println("[AppointmentReminderBot] [OUTBOUND SKIPPED] Appt ID " + appointment.getId() + " has NULL time configuration.");
                        return;
                    }

                    System.out.println("[AppointmentReminderBot] [OUTBOUND CHECK] Appt ID " + appointment.getId() + " time is " + apptTime + ". Evaluating " + messages.size() + " message rule(s).");

                    for (Message msg : messages) {
                        int milestoneDays = msg.getDayMileStone();
                        Duration milestoneDuration = Duration.ofDays(milestoneDays);
                        boolean isBeforeRule = msg.isBefore();

                        System.out.println("[AppointmentReminderBot] [RULE EVAL] Evaluating Message ID " + msg.getId() + " | milestoneDays: " + milestoneDays + " | isBefore: " + isBeforeRule);

                        boolean shouldSend = false;

                        if (isBeforeRule) {
                            if (currentTime.isBefore(apptTime)) {
                                Duration timeUntilAppt = Duration.between(currentTime, apptTime);
                                System.out.println("[AppointmentReminderBot] [RULE EVAL] Before-rule check: timeUntilAppt = " + timeUntilAppt + ", threshold = " + milestoneDuration);
                                if (timeUntilAppt.compareTo(milestoneDuration) <= 0) {
                                    shouldSend = true;
                                    System.out.println("[AppointmentReminderBot] [RULE EVAL] Before-rule condition MET for Message ID " + msg.getId());
                                } else {
                                    System.out.println("[AppointmentReminderBot] [RULE EVAL] Before-rule condition NOT MET (time remaining exceeds milestone).");
                                }
                            } else {
                                System.out.println("[AppointmentReminderBot] [RULE EVAL] Before-rule skipped: current time is after appointment time.");
                            }
                        } else {
                            if (currentTime.isAfter(apptTime)) {
                                Duration timeSinceAppt = Duration.between(apptTime, currentTime);
                                System.out.println("[AppointmentReminderBot] [RULE EVAL] After-rule check: timeSinceAppt = " + timeSinceAppt + ", threshold = " + milestoneDuration);
                                if (timeSinceAppt.compareTo(milestoneDuration) >= 0) {
                                    shouldSend = true;
                                    System.out.println("[AppointmentReminderBot] [RULE EVAL] After-rule condition MET for Message ID " + msg.getId());
                                } else {
                                    System.out.println("[AppointmentReminderBot] [RULE EVAL] After-rule condition NOT MET (time elapsed is less than milestone).");
                                }
                            } else {
                                System.out.println("[AppointmentReminderBot] [RULE EVAL] After-rule skipped: current time is before appointment time.");
                            }
                        }

                        if (shouldSend) {
                            System.out.println("[AppointmentReminderBot] [OUTBOUND SEND] Message ID " + msg.getId() + " is targeted for dispatch. Checking history for Appt ID " + appointment.getId());
                            
                            if (hasSentMessage(appointment, milestoneDays, isBeforeRule)) {
                                System.out.println("[AppointmentReminderBot] [OUTBOUND SKIPPED] Message already sent previously for milestone " + milestoneDays + " (isBefore: " + isBeforeRule + ") on Appt ID " + appointment.getId());
                                continue;
                            }

                            if (userOpt.isEmpty()) {
                                System.out.println("[AppointmentReminderBot] [OUTBOUND SKIPPED] User object missing in context for Appt ID " + appointment.getId());
                                continue;
                            }

                            User user = userOpt.get();
                            System.out.println("[AppointmentReminderBot] [OUTBOUND PARSE] Parsing text payload for user phone: " + user.getPhone());
                            String textMessage = parseText(user, appointment, msg.getTextList());

                            // Send via TextMgr updated signature: sendText(String tag, String recipient, String text)
                            System.out.println("[AppointmentReminderBot] [TEXTMGR CALL] Calling textMgr.sendText for Appt ID " + appointment.getId() + " to phone: " + user.getPhone());
                            Long textId = textMgr.sendText(TAG, user.getPhone(), textMessage);
                            System.out.println("[AppointmentReminderBot] [OUTBOUND SUCCESS] Successfully sent text ID: " + textId + " to Appt ID: " + appointment.getId());

                            appointment.setCurrentTextId(textId);
                            appointment.setCurrentReminderId(msg.getId());
                            appointment.setWaitingForResponse(true);
                            markMessageSent(appointment, milestoneDays, isBeforeRule);
                            System.out.println("[AppointmentReminderBot] [STATE UPDATED] Appt ID " + appointment.getId() + " state updated: waitingForResponse=true, currentReminderId=" + msg.getId() + ", currentTextId=" + textId);

                            break;
                        }
                    }
                } catch (Exception e) {
                    System.out.println("[AppointmentReminderBot] Error processing appointment ID " + appointment.getId() + ": " + e.getMessage());
                    e.printStackTrace();
                }
                System.out.println("[AppointmentReminderBot] [THREAD POOL] Finished execution task for Appointment ID: " + appointment.getId());
            });
        }
        System.out.println("[AppointmentReminderBot] --- TICK END ---");
    }

    private void handleCustomerReply(Appointment appointment, User user) {
        System.out.println("[AppointmentReminderBot] [HANDLE REPLY] Fetching incoming replies from textMgr for phone: " + user.getPhone() + " and tag: " + TAG);
        List<String> incomingReplies = textMgr.getReplies(user.getPhone(), TAG);

        if (incomingReplies.isEmpty()) {
            System.out.println("[AppointmentReminderBot] [HANDLE REPLY] No incoming replies found.");
            return;
        }

        System.out.println("[AppointmentReminderBot] [HANDLE REPLY] Found " + incomingReplies.size() + " incoming reply/replies.");

        Long messageId = appointment.getCurrentReminderId();
        if (messageId == null) {
            System.out.println("[AppointmentReminderBot] [HANDLE REPLY] Appt ID " + appointment.getId() + " has a null currentReminderId. Ignoring incoming replies.");
            return;
        }

        Message currentMessage = messageRepo.findById(messageId).orElse(null);
        if (currentMessage == null) {
            System.out.println("[AppointmentReminderBot] [HANDLE REPLY] Could not find Message entity with ID " + messageId + " for Appt ID " + appointment.getId());
            return;
        }

        String latestReplyText = incomingReplies.get(incomingReplies.size() - 1);
        System.out.println("[AppointmentReminderBot] [REPLY RECEIVED] Appt ID " + appointment.getId() 
                + " latest reply text: \"" + latestReplyText + "\"");

        List<Long> responseIds = currentMessage.getResponseIds();
        if (responseIds == null || responseIds.isEmpty()) {
            System.out.println("[AppointmentReminderBot] [HANDLE REPLY] Current Message ID " + messageId + " contains no configured response IDs.");
            return;
        }

        System.out.println("[AppointmentReminderBot] [HANDLE REPLY] Evaluating " + responseIds.size() + " potential response configuration(s).");

        for (Long responseId : responseIds) {
            Response response = responseRepo.findById(responseId).orElse(null);
            if (response == null) {
                System.out.println("[AppointmentReminderBot] [HANDLE REPLY] Warning: Response ID " + responseId + " not found in repository.");
                continue;
            }

            boolean matches = ResponseMatcher.matches(response, latestReplyText);
            System.out.println("[AppointmentReminderBot] [MATCH CHECK] Checking response ID " + responseId + " (\"" + response.getText() + "\") against reply \"" + latestReplyText + "\". Matches: " + matches);

            if (!matches) {
                continue;
            }

            ResponseAction newAction = response.getAction();
            ResponseAction previousAction = lastExecutedActions.get(appointment.getId());
            System.out.println("[AppointmentReminderBot] [ACTION RESOLVED] Matched response ID " + responseId + ". New Action: " + newAction + ", Previous Action in map: " + previousAction);

            // Update branch
            if (previousAction != null) {
                if (previousAction != newAction) {
                    System.out.println("[AppointmentReminderBot] [ACTION UPDATE] Action changed from " + previousAction + " to " + newAction + " for Appt ID " + appointment.getId());
                    actionMgr.undoAction(previousAction, appointment);
                    actionMgr.doAction(newAction, appointment);
                    lastExecutedActions.put(appointment.getId(), newAction);

                    String changeText = "Response changed to: \"" + response.getText() + "\"";
                    System.out.println("[AppointmentReminderBot] [TEXTMGR CALL] Sending change notification text to user: " + user.getPhone());
                    Long newTextId = textMgr.sendText(TAG, user.getPhone(), changeText);

                    appointment.setCurrentTextId(newTextId);
                    appointmentRepo.save(appointment);
                    System.out.println("[AppointmentReminderBot] [STATE UPDATED] Appt ID " + appointment.getId() + " response modification saved successfully.");
                } else {
                    System.out.println("[AppointmentReminderBot] [ACTION UPDATE] Action remains identical (" + newAction + "). No update triggered.");
                }
                return;
            }

            // Initial response branch
            System.out.println("[AppointmentReminderBot] [INITIAL RESPONSE] Executing initial response handler actions for Appt ID " + appointment.getId());
            Long newTextId = textMgr.sendText(TAG, user.getPhone(), response.getResponse());

            appointment.setCurrentTextId(newTextId);
            appointment.setWaitingForResponse(false);

            actionMgr.doAction(newAction, appointment);
            lastExecutedActions.put(appointment.getId(), newAction);

            appointmentRepo.save(appointment);
            System.out.println("[AppointmentReminderBot] [STATE UPDATED] Initial response processed and saved successfully for Appt ID " + appointment.getId());
            return;
        }
        System.out.println("[AppointmentReminderBot] [HANDLE REPLY] Finished evaluation loop. No matching response pattern matched the latest reply text.");
    }

    private boolean hasSentMessage(Appointment appointment, int milestone, boolean isBefore) {
        List<Integer> milestones = appointment.getMileStoneList();
        System.out.println("[AppointmentReminderBot] [HISTORY CHECK] Checking milestone list for Appt ID " + appointment.getId() + ". Raw milestones: " + milestones);
        if (milestones == null) {
            return false;
        }
        int key = isBefore ? milestone : -milestone;
        boolean exists = milestones.contains(key);
        System.out.println("[AppointmentReminderBot] [HISTORY CHECK] Calculated milestone key: " + key + ". Already sent? " + exists);
        return exists;
    }

    private void markMessageSent(Appointment appointment, int milestone, boolean isBefore) {
        int key = isBefore ? milestone : -milestone;
        System.out.println("[AppointmentReminderBot] [MARK SENT] Adding milestone key " + key + " to Appt ID " + appointment.getId() + " tracking list.");
        appointment.addMileStoneToList(key);
        appointment.setTextSentNow();
        appointmentRepo.save(appointment);
        System.out.println("[AppointmentReminderBot] [MARK SENT] Successfully saved appointment " + appointment.getId() + " after marking message sent.");
    }
}
