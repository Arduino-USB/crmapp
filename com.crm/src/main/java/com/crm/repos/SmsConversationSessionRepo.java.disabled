package com.crm.repos;

import com.crm.entites.SmsConversationSession;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;

import java.util.Optional;

@Repository
public interface SmsConversationSessionRepo extends JpaRepository<SmsConversationSession, Long> {
    Optional<SmsConversationSession> findByRecipientPhone(String recipientPhone);
}
