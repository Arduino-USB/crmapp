package com.crm.repos;

import com.crm.entites.MostRecentReplies;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;


import java.util.Optional;
@Repository
public interface MostRecentRepliesRepo extends JpaRepository<MostRecentReplies, String> {
	Optional<MostRecentReplies> findByNumber(String number);
}
