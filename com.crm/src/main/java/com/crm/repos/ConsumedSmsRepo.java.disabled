package com.crm.repos;

import com.crm.entites.ConsumedSms;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;

@Repository
public interface ConsumedSmsRepo extends JpaRepository<ConsumedSms, Long> {
    boolean existsByPhoneNumberAndMessageTimeAndMessageText(String phoneNumber, Long messageTime, String messageText);
}
