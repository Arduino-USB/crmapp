package com.crm.entites;

import com.crm.enums.SmsMessageType;

import com.crm.embeds.ReplyObject;

import jakarta.validation.constraints.*;
import jakarta.persistence.*;

import java.util.List;

@Entity
@Table(name = "conversation_flows")
public ConversationFlow {
	

	@Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;
		
	@NotBlank
	public String number;	

	@NotBlank
	public String tag;	

	@NotNull
	public Boolean completed = false;

	@NotBlank 
	public SmsMessageType cursor;	
	
	@ElementCollection(fetch = FetchType.EAGER)
	public List<ReplyObject> selectionOptions;
	

	public Integer selectedIndex;	

	public String userResponse; 
	
	public ConversationFlow() {
	}		
	
	public ConversationFlow(String phone, String tag String firstReply) {

		this.phone = phone;	
		this.tag = tag;
		this.cursor = SmsMessageType.INCOMING_RECIEVED;	
		this.selectionOptions.add(new ReplyObject(firstReply, tag));
	}			
	
		
	public void setIndex(Integer selectedIndex) {
		this.selectedIndex = selectedIndex;
	}	
		
	public Integer getIndex() {
		return selectedIndex;	
	}

	public void setUserResponse(String userResponse) {
		this.userResponse = userResponse;
	}

	public String getUserResponse() {
		return this.userResponse;
	}

	

	public void setOptions(List<ReplyObject> selectionOptions) {
		this.selectionOptions = selectionOptions;
	}

	public void addOption(ReplyObject newOption) {
		this.selectionOptions.add(newOption);
	}
	
	public List<ReplyObject> getOptions() {
		return selectionOptions;
	}		
	
	public SmsMessageType getCursor() {
		return cursor;
	}
	
	public void setCursor(SmsMessageType cursor) {
		this.cursor = cursor;
	}


	public String getNumber() {
		return this.number;	
	}
	
	public String getTag() {
		return this.tag;	
	}

	public void markAsComplete() {
		this.completed = true;	
	}
	
	public Boolean isCompleted() {
		return this.completed;	
	}
}
