package com.crm.embeds;

import jakarta.validation.constraints.*;
import jakarta.persistence.*;

import java.util.Instant;
import java.time.DateTimeFormatter;
import java.time.ZoneId;

@Embeddable
public class ReplyObject {

	private static DateTimeFormatter formatter = DateTimeFormatter.ofPattern("EEEE, MMMM d, yyyy 'at' h:mm a").withZone(ZoneId.systemDefault());	
	
	public String tag;
	
	public String reply;	
	
	public Instant timeOfReply;
	
	public ReplyObject(String tag, String reply) {
		this.tag = tag;
		this.reply = reply;
		timeOfReply = Instant.now();
	}
	
	@Override
	public String toString() {
		return "'" + this.tag + "'" + "\n\t - \"" + this.reply + "\" (" + formatter.format(timeOfReply) + ")\n";	
	}

}
